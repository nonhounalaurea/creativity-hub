# Copia questo file in .env.local (non committare mai .env.local).
# Su Vercel: Project Settings > Environment Variables.

# Nome mostrato nel logo (facoltativo, default "Creativity.hub").
NEXT_PUBLIC_APP_NAME=Creativity.hub

# Supabase (Project Settings > API). Solo URL e chiave publishable:
# mai chiavi secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo test e2e di login (facoltativi, non committare).
# E2E_EMAIL=
# E2E_PASSWORD=
